# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Origen público de la aplicación (sin barra final). Se usa para CSRF y enlaces.
APP_ORIGIN=http://localhost:5173
# En local con HTTP debe ser false; en producción (HTTPS) true.
COOKIE_SECURE=false
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase (Settings → API)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Solo para el CLI de invitaciones y la caché de mercado. Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------------------------------------------------------------------------
# Datos de mercado
# ---------------------------------------------------------------------------
# Símbolo de referencia por defecto (MSCI World).
DEFAULT_BENCHMARK_SYMBOL=URTH
# Identificador que Yahoo exige en las peticiones.
MARKET_USER_AGENT=CarteraInversion/0.1 (+https://example.com)
MARKET_TIMEOUT_MS=5000
MARKET_CACHE_QUOTE_MINUTES=15

# ---------------------------------------------------------------------------
# Invitaciones
# ---------------------------------------------------------------------------
# Base del enlace que imprime el CLI (por defecto APP_ORIGIN).
INVITE_BASE_URL=http://localhost:5173
INVITE_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Límites de intentos (valores por defecto del diseño).
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_WINDOW_MINUTES=15
